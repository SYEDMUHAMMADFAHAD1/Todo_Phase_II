# Backend Dockerfile for Railway deployment
FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/. .

# Railway sets PORT automatically; do NOT set a default here
# The run_server.py reads PORT from environment at runtime
EXPOSE 8000

# Use shell form so $PORT expands properly, or use Python script that reads env var
# Using Python script approach (run_server.py handles PORT correctly)
CMD python run_server.py

# ===========================================
# Backend Environment Variables (Railway)
# ===========================================

# Database (PostgreSQL - required)
DATABASE_URL="postgresql+asyncpg://user:password@host/dbname?ssl=require"

# Authentication (required - shared with frontend)
BETTER_AUTH_SECRET="your_shared_secret_min_32_chars_here"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI (required for chat feature)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-3.5-turbo"
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# CORS (comma-separated allowed origins for production)
CORS_ORIGINS="https://your-app.vercel.app,http://localhost:3000"

# ===========================================
# Frontend Environment Variables (Vercel)
# ===========================================

# Backend URL (required - your Railway backend URL)
# BACKEND_URL="https://your-backend.railway.app"
# NEXT_PUBLIC_API_URL="https://your-backend.railway.app/api"
